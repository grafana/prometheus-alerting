{
  "extends": "./.config/tsconfig.json",
  "compilerOptions": {
    "ignoreDeprecations": "6.0",
    "rootDir": ".",
    // Needed to read the `exports` maps in the @grafana packages. Set here rather than in
    // `.config/tsconfig.json`, which the scaffolding tool regenerates.
    "module": "esnext",
    "moduleResolution": "bundler"
  },
  "include": ["src", "tests", "packages", "types", ".config/types"],
  "ts-node": {
    "compilerOptions": {
      "module": "commonjs",
      "target": "es5",
      "esModuleInterop": true,
      "moduleResolution": "node",
      "ignoreDeprecations": "6.0"
    },
    "transpileOnly": true
  }
}
