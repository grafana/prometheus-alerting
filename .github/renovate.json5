{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'github>grafana/grafana-renovate-config//presets/base',
    'github>grafana/grafana-renovate-config//presets/labels',
  ],
  minimumReleaseAge: '3 days',
  prCreation: 'not-pending',
  internalChecksFilter: 'strict',
  packageRules: [
    {
      // `config:best-practices` (via the grafana base preset) pulls in
      // `security:minimumReleaseAgeNpm`, whose packageRule sets the npm gate and
      // would override the top-level value (packageRules always beat top-level
      // config). Re-assert 3 days for npm here so the gate matches the top-level
      // setting and mise.toml/pnpm-workspace.yaml no matter what the preset does.
      matchDatasources: ['npm'],
      minimumReleaseAge: '3 days',
    },
    {
      // Hold react-router on 6.x. It is a webpack external (see
      // .config/bundler/externals.ts), so Grafana supplies the router at runtime and
      // the version declared here only drives types and unit tests. @grafana/scenes
      // peer-requires react-router-dom ^6.28.0, so 6.x is what keeps the declared
      // version aligned with both that peer contract and the host router.
      // 7.x/8.x resolve no runtime vulnerability and break the scenes peer.
      matchPackageNames: ['react-router', 'react-router-dom'],
      allowedVersions: '<7',
    },
    {
      // Pin the Node and pnpm runtimes exactly, sourced from mise.toml.
      matchManagers: ['mise'],
      rangeStrategy: 'pin',
    },
    {
      // Pin Docker Compose image tags exactly and add SHA256 digests
      // so images are pinned by content, not just by tag name.
      matchManagers: ['docker-compose'],
      rangeStrategy: 'pin',
      pinDigests: true,
    },
  ],
  vulnerabilityAlerts: {
    // Security fixes bypass the 3-day age gate and land ASAP.
    minimumReleaseAge: null,
    labels: ['security'],
  },
}
