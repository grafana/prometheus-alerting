{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'github>grafana/grafana-renovate-config//presets/base',
    'github>grafana/grafana-renovate-config//presets/labels',
  ],
  env: {
    // Trust mise config files in Renovate's sandbox so `mise lock` can run
    // without failing on the untrusted `mise.development.toml` (paranoid = true
    // in mise.toml requires explicit trust for env-specific config files).
    MISE_TRUSTED_CONFIG_PATHS: '/tmp/renovate/repos/github/grafana/prometheus-alerting',
  },
  minimumReleaseAge: '7 days',
  prCreation: 'not-pending',
  internalChecksFilter: 'strict',
  packageRules: [
    {
      // `config:best-practices` (via the grafana base preset) pulls in
      // `security:minimumReleaseAgeNpm`, whose packageRule sets a 3-day npm
      // gate that overrides the top-level 7 days (packageRules always beat
      // top-level config). Re-assert 7 days for npm here so it actually wins.
      matchDatasources: ['npm'],
      minimumReleaseAge: '7 days',
    },
    {
      // Pin the Node and pnpm runtimes exactly, sourced from mise.toml.
      matchManagers: ['mise'],
      rangeStrategy: 'pin',
    },
    {
      // Pin Docker Compose image tags exactly and add SHA256 digests
      // so images are pinned by content, not just by tag name.
      matchManagers: ['docker-compose'],
      rangeStrategy: 'pin',
      pinDigests: true,
    },
  ],
  vulnerabilityAlerts: {
    // Security fixes bypass the 7-day age gate and land ASAP.
    minimumReleaseAge: null,
    labels: ['security'],
  },
}
