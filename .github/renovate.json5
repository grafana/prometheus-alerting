{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'github>grafana/grafana-renovate-config//presets/base',
    'github>grafana/grafana-renovate-config//presets/labels',
    // One PR for every minor and patch update, instead of one each. Majors still get their own.
    'group:allNonMajor',
  ],
  // Open update PRs once a week rather than as soon as releases land. Security fixes ignore this
  // (see vulnerabilityAlerts below).
  schedule: ['before 9am on monday'],
  minimumReleaseAge: '3 days',
  // Don't set `prCreation: 'not-pending'` here. It makes Renovate wait for CI on its branch before
  // opening a PR, but our CI only runs on pull requests, so it waits forever. That stopped every
  // non-security PR from June to October 2026. The 3-day wait is already handled by
  // minimumReleaseAge and internalChecksFilter.
  internalChecksFilter: 'strict',
  'docker-compose': {
    // Renovate only looks for files named like compose*.yaml by default. The service files
    // pulled in by docker-compose.yaml live in .config/compose/ under their own names, so add those.
    managerFilePatterns: ['/^\\.config/compose/[^/]+\\.ya?ml$/'],
  },
  packageRules: [
    {
      // `config:best-practices` (via the grafana base preset) pulls in
      // `security:minimumReleaseAgeNpm`, whose packageRule sets the npm gate and
      // would override the top-level value (packageRules always beat top-level
      // config). Re-assert 3 days for npm here so the gate matches the top-level
      // setting and mise.toml/pnpm-workspace.yaml no matter what the preset does.
      matchDatasources: ['npm'],
      minimumReleaseAge: '3 days',
    },
    {
      // Hold react-router on 6.x. It is a webpack external (see
      // .config/bundler/externals.ts), so Grafana supplies the router at runtime and
      // the version declared here only drives types and unit tests. @grafana/scenes
      // peer-requires react-router-dom ^6.28.0, so 6.x is what keeps the declared
      // version aligned with both that peer contract and the host router.
      // 7.x/8.x resolve no runtime vulnerability and break the scenes peer.
      matchPackageNames: ['react-router', 'react-router-dom'],
      allowedVersions: '<7',
    },
    {
      // Grafana supplies @grafana/ui, @grafana/data and @grafana/runtime to the plugin at runtime
      // (see .config/bundler/externals.ts), so the versions here have to match the oldest Grafana
      // we support, `grafanaDependency` in src/plugin.json (>=13.1.0). Newer types let code compile
      // that breaks on that Grafana: 13.2 renamed what getTagColorsFromName returns, for one. The
      // rest of the 13.x set moves with them. Widen this when `grafanaDependency` goes up.
      matchPackageNames: [
        '@grafana/alerting',
        '@grafana/data',
        '@grafana/i18n',
        '@grafana/runtime',
        '@grafana/schema',
        '@grafana/ui',
      ],
      allowedVersions: '~13.1.0',
    },
    {
      // typescript-eslint 8 refuses to run on TypeScript 7 ("does not support TS 7.0"), and TS 7
      // has no compiler API for fork-ts-checker-webpack-plugin to use either. Widen this once
      // typescript-eslint supports it.
      matchPackageNames: ['typescript'],
      allowedVersions: '<7',
    },
    {
      // These are Grafana's own reusable workflows, which every Grafana repo references by tag or
      // branch. Keep it that way instead of swapping in commit SHAs.
      matchPackageNames: ['grafana/plugin-ci-workflows', 'grafana/security-github-actions'],
      pinDigests: false,
    },
    {
      // .config/Dockerfile builds FROM grafana/${grafana_image}:${grafana_version}, so the
      // version is picked at build time (GRAFANA_VERSION). There's nothing to pin.
      matchPackageNames: ['grafana/grafana-enterprise'],
      enabled: false,
    },
    {
      // Pin the Node and pnpm runtimes exactly, sourced from mise.toml.
      matchManagers: ['mise'],
      rangeStrategy: 'pin',
    },
    {
      // Hold Node on the 24.x LTS line. Renovate has no "LTS only" setting, and its LTS-aware
      // `node` versioning doesn't apply to the `node:<major>-alpine` images in
      // .config/compose/*.yaml. Widen this by hand when moving to the next LTS (26.x from
      // 2026-10-28).
      matchDepNames: ['node'],
      allowedVersions: '^24',
    },
    {
      // Pin Docker Compose image tags exactly and add SHA256 digests
      // so images are pinned by content, not just by tag name.
      matchManagers: ['docker-compose'],
      rangeStrategy: 'pin',
      pinDigests: true,
    },
  ],
  vulnerabilityAlerts: {
    // Security fixes bypass the 3-day age gate and land ASAP.
    minimumReleaseAge: null,
    labels: ['security'],
  },
}
