{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: ['github>grafana/grafana-renovate-config//presets/base'],
  // Wait 7 days after a release before opening a PR — mirrors `.npmrc`
  // `min-release-age=7d` so we never pull a freshly published package.
  minimumReleaseAge: '7 days',
  internalChecksFilter: 'strict',
  packageRules: [
    {
      // Pin the Node runtime exactly, mirroring `.nvmrc` (v24.16.0).
      matchManagers: ['nvm'],
      rangeStrategy: 'pin',
    },
  ],
  vulnerabilityAlerts: {
    // Security fixes bypass the 7-day age gate and land ASAP.
    minimumReleaseAge: null,
    labels: ['security'],
  },
}
