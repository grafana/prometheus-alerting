{
  "name": "prometheus-alerting",
  "version": "1.6.1",
  "scripts": {
    "build": "rspack -c ./.config/rspack/rspack.config.ts --env production",
    "dev": "rspack -w -c ./.config/rspack/rspack.config.ts --env development",
    "test": "rstest --coverage",
    "test:ci": "rstest --passWithNoTests",
    "typecheck": "tsc --noEmit",
    "lint": "eslint --cache .",
    "lint:fix": "pnpx lint -- --fix && prettier --write --list-different .",
    "rev-dep": "rev-dep config run",
    "rev-dep:list": "rev-dep config run --list-all-issues",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui --project=e2e-tests",
    "server": "docker compose up --build --force-recreate",
    "//update-config": "Regenerates .config/ from the scaffolding tool. Pinned to the same version .config/.cprc.json records, so Renovate raising a bump is the signal that there is an update to run.",
    "update-config": "create-plugin update",
    "//sign": "Pinned intentionally — runs with GRAFANA_ACCESS_POLICY_TOKEN in ci.yml. Do not change to @latest; let Renovate bump the version.",
    "sign": "sign-plugin",
    "i18n-extract": "i18next --config src/locales/i18next-parser.config.js",
    "preinstall": "node scripts/check-mise.js",
    "prepare": "lefthook install || true",
    "test:watch": "rstest --watch"
  },
  "author": "Grafana",
  "license": "Apache-2.0",
  "devDependencies": {
    "@grafana/create-plugin": "7.11.0",
    "@grafana/eslint-config": "^9.0.0",
    "@grafana/external-alertmanager": "workspace:*",
    "@grafana/external-rules": "workspace:*",
    "@grafana/go-template": "workspace:*",
    "@grafana/plugin-e2e": "^3.8.0",
    "@grafana/sign-plugin": "^3.3.2",
    "@grafana/tsconfig": "^2.1.0",
    "@playwright/test": "^1.60.0",
    "@rspack/cli": "^2.2.0",
    "@rspack/core": "^2.2.0",
    "@rstest/core": "0.11.12",
    "@rstest/coverage-v8": "0.11.12",
    "@stylistic/eslint-plugin-ts": "^4.4.1",
    "@swc/helpers": "^0.5.21",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/js-yaml": "^4.0.9",
    "@types/lodash": "^4.17.24",
    "@types/node": "^24.13.5",
    "@types/object-hash": "^3.0.6",
    "@types/pluralize": "^0.0.33",
    "@types/prismjs": "^1.26.6",
