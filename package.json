    "css-loader": "^7.1.0",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsdoc": "^63.0.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-rspack-plugin": "^5.0.1",
    "fishery": "^2.4.0",
    "glob": "^13.0.6",
    "happy-dom": "^20.9.0",
    "i18next-parser": "^9.4.0",
    "imports-loader": "^5.0.0",
    "msw": "^2.14.6",
    "prettier": "^3.8.3",
