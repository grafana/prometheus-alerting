{
  "name": "prometheus-alerting",
  "version": "1.0.0",
  "scripts": {
    "build": "webpack -c ./webpack.config.ts --env production",
    "dev": "webpack -w -c ./webpack.config.ts --env development",
    "test": "vitest --coverage",
    "test:ci": "vitest run --passWithNoTests",
    "test:ui": "vitest --ui",
    "typecheck": "tsc --noEmit",
    "lint": "eslint --cache .",
    "lint:fix": "npm run lint -- --fix && prettier --write --list-different .",
    "rev-dep": "rev-dep config run",
    "rev-dep:list": "rev-dep config run --list-all-issues",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui --project=e2e-tests",
    "server": "docker compose up --build --force-recreate",
    "//sign": "Pinned intentionally — runs with GRAFANA_ACCESS_POLICY_TOKEN in ci.yml. Do not change to @latest; let Renovate bump the version.",
    "sign": "npx --yes @grafana/sign-plugin@3.2.2",
    "i18n-extract": "i18next --config src/locales/i18next-parser.config.js",
    "prepare": "husky"
  },
  "author": "Grafana",
  "license": "Apache-2.0",
  "devDependencies": {
    "@grafana/eslint-config": "^8.2.0",
    "@grafana/external-alertmanager": "workspace:*",
    "@grafana/external-rules": "workspace:*",
    "@grafana/plugin-e2e": "^2.2.1",
    "@grafana/tsconfig": "^2.0.0",
    "@playwright/test": "^1.56.0",
    "@stylistic/eslint-plugin-ts": "^2.9.0",
    "@swc/core": "^1.3.90",
    "@swc/helpers": "^0.5.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.19.19",
    "@types/object-hash": "^3.0.6",
    "@types/pluralize": "^0.0.33",
    "@types/prismjs": "^1.26.5",
    "@types/react": "^18.3.29",
    "@types/react-dom": "^18.3.7",
    "@typescript-eslint/eslint-plugin": "^8.3.0",
    "@typescript-eslint/parser": "^8.3.0",
    "@vitejs/plugin-react": "^5.1.2",
    "@vitest/coverage-v8": "^3.2.4",
    "@vitest/ui": "^3.2.4",
    "copy-webpack-plugin": "^14.0.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^8.8.0",
    "eslint-plugin-jsdoc": "^51.2.3",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-webpack-plugin": "^5.0.0",
    "fishery": "^2.4.0",
    "fork-ts-checker-webpack-plugin": "^8.0.0",
    "glob": "^10.2.7",
    "happy-dom": "^20.3.9",
    "husky": "^9.1.7",
    "i18next-parser": "^9.3.0",
    "imports-loader": "^5.0.0",
    "lint-staged": "^16.3.1",
    "msw": "^2.12.7",
    "prettier": "^2.8.7",
    "replace-in-file-webpack-plugin": "^1.0.6",
    "rev-dep": "^2.11.0",
    "swc-loader": "^0.2.3",
    "terser-webpack-plugin": "^5.3.10",
    "ts-node": "^10.9.2",
    "typescript": "5.5.4",
    "vite": "^7.3.2",
    "vitest": "^3.2.4",
    "webpack": "^5.94.0",
    "webpack-cli": "^5.1.4",
    "webpack-livereload-plugin": "^3.0.2",
    "webpack-merge": "^5.10.0",
    "webpack-subresource-integrity": "^5.1.0",
    "webpack-virtual-modules": "^0.6.2"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@emotion/css": "11.10.6",
    "@grafana/alerting": "^13.0.1",
    "@grafana/data": "^13.0.1",
    "@grafana/i18n": "^13.0.1",
    "@grafana/plugin-ui": "^0.13.1",
    "@grafana/runtime": "^13.0.1",
    "@grafana/scenes": "8.2.5",
    "@grafana/schema": "^13.0.1",
    "@grafana/ui": "^13.0.1",
    "@hello-pangea/dnd": "^18.0.1",
    "@hookform/resolvers": "^5.2.2",
    "@popperjs/core": "^2.11.8",
    "@react-hookz/web": "^25.1.1",
    "@reduxjs/toolkit": "^2.11.2",
    "browser-fs-access": "^0.38.0",
    "immer": "^10.1.3",
    "ix": "^7.0.0",
    "js-yaml": "^4.1.0",
    "lodash": "^4.17.21",
    "object-hash": "^3.0.0",
    "p-retry": "^7.1.1",
    "pluralize": "^8.0.0",
    "prismjs": "^1.30.0",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-hook-form": "^7.65.0",
    "react-loading-skeleton": "^3.5.0",
    "react-redux": "^9.2.0",
    "react-router-dom": "^6.22.0",
    "reduce-reducers": "^1.0.4",
    "rxjs": "7.8.2",
    "type-fest": "^5.1.0",
    "yaml": "^2.8.1",
    "zod": "^4.1.12"
  },
  "packageManager": "npm@11.15.0",
  "workspaces": [
    "packages/*"
  ],
  "overrides": {
    "immutable@5.1": "~5.1.5",
    "@grafana/alerting": {
      "@grafana/data": "$@grafana/data",
      "@grafana/ui": "$@grafana/ui",
      "@grafana/runtime": "$@grafana/runtime"
    },
    "react-data-grid": "~7.0.0-beta.57"
  },
  "volta": {
    "node": "22.21.1"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --cache --fix",
      "prettier --write"
    ],
    "*.{js,json,css,md}": [
      "prettier --write"
    ]
  }
}
