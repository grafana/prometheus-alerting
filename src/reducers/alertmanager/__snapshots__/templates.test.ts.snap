exports[`notification templates > should add a new notification template 1`] = `
{
  "alertmanager_config": {
    "inhibit_rules": [],
    "receivers": [
      {
        "name": "empty-receiver",
      },
    ],
    "route": {
      "group_interval": "5m",
      "group_wait": "30s",
      "receiver": "empty-receiver",
      "repeat_interval": "4h",
    },
    "templates": [
      "foo",
    ],
    "time_intervals": [],
  },
  "template_files": {
    "foo": "{{ define "foo" }}
  foo
{{ end }}",
  },
}
`;

